{
  "name": "dropz-electron",
  "version": "0.8.0",
  "description": "Electron frontend for Dropz",
  "main": "src/main.js",
  "homepage": "https://dropz.cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewazoosyndicate/go.dropz.git"
  },
  "author": {
    "name": "Dropz",
    "email": "thibaut@dropz.cloud"
  },
  "scripts": {
    "start": "electron .",
    "vite:build": "vite build",
    "vite:dev": "vite dev",
    "build": "vite build && electron-builder",
    "test-build": "./test-build.sh",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cd .. && make build && cd frontend && vite build && npm start"
  },
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "electron": "^25.0.0",
    "electron-builder": "^24.4.0",
    "grpc-tools": "^1.13.0",
    "svelte": "^5.50.2",
    "vite": "^7.3.1",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "localDependencies": {
    "font-awesome": "6.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.15",
    "electron-log": "^4.4.8",
    "google-protobuf": "^3.21.4"
  },
  "build": {
    "publish": null,
    "appId": "com.dropz.app",
    "productName": "Dropz",
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/proto/**/*",
      "src/libs/**/*",
      "src/icons/**/*",
      "src/imgs/**/*",
      "dist-svelte/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Dropz connects to GoPro cameras over Bluetooth to manage and sync them.",
        "NSBluetoothPeripheralUsageDescription": "Dropz connects to GoPro cameras over Bluetooth to manage and sync them.",
        "NSLocationUsageDescription": "macOS requires location access to scan for the GoPro WiFi network.",
        "NSLocationWhenInUseUsageDescription": "macOS requires location access to scan for the GoPro WiFi network."
      }
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ],
      "maintainer": "thibaut@dropz.cloud",
      "icon": "resources/icons/png",
      "desktop": {
        "Icon": "dropz-electron",
        "Name": "Dropz",
        "Comment": "Electron frontend for Dropz",
        "Categories": "Utility;",
        "StartupWMClass": "dropz-electron"
      },
      "artifactName": "${productName}.${ext}",
      "executableName": "dropz-electron",
      "synopsis": "Electron frontend for Dropz",
      "mimeTypes": [
        "x-scheme-handler/dropz"
      ],
      "packageCategory": "Utility",
      "vendor": "Dropz"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    }
  }
}
